# Bin Packer 3D Configuration Example
# Copy this file to .env and customize for your environment

# Bin dimensions (mm)
BIN_LENGTH=860
BIN_WIDTH=890
BIN_HEIGHT=1040
BIN_MAX_WEIGHT=  # Optional: Maximum weight per bin in kg

# Algorithm settings
PACKING_STRATEGY=ffd  # Options: ffd, shelf
ALLOW_ROTATION=true
SORT_BY_VOLUME=true
MAX_BINS=  # Optional: Maximum number of bins

# Data settings
INPUT_FILE=  # Optional: Default input file path
OUTPUT_DIR=output
DATASET_DIR=DATASETS

# Visualization settings
VIZ_ENABLED=true
VIZ_FORMAT=html
VIZ_ALL_BINS=true
